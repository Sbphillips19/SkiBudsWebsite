---
layout: base.njk
lastModified: 2026-09-29
title: SkiBuds FAQ
seoTitle: Ski Buddies, Forecasts & App Launch FAQ
description: Get answers about the SkiBuds launch, finding ski buddies, snow forecasts, powder alerts, GPS run tracking, offline maps, and opt-in location sharing.
pageType: FAQPage
---

  <div class="shell legal">
    <h1>SkiBuds questions, answered</h1>
    <p class="lede">The new SkiBuds app is coming soon to iOS and Android. These answers describe the rebuild; <a href="/#waitlist">join the launch waitlist</a> for availability updates.</p>
    <p class="legal__meta"><time datetime="{{ lastModified | isoDate }}">Last updated: {{ lastModified | dateDisplay }}</time></p>

    <nav class="legal__toc" aria-label="Table of contents">
      <h2>Quick Links</h2>
      <ul>
        {% for section in faqs.sections %}
        <li><a href="#{{ section.id }}">{{ section.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    {% for section in faqs.sections %}
    <section id="{{ section.id }}">
      <h2>{{ section.title }}</h2>

      {% for item in section.items %}
      <details>
        <summary><h3>{{ item.q }}</h3></summary>
        <p>{{ item.a | safe }}</p>
      </details>
      {% endfor %}
    </section>
    {% endfor %}

    <hr>
    <p><a href="/privacy/">Privacy Policy</a> &middot; <a href="/terms/">Terms of Service</a> &middot; <a href="/">Home</a></p>
    <a href="#top" class="btn btn--quiet" style="margin-top: 2rem;">Back to top</a>
  </div>

<script type="application/ld+json">
  {% set qjson = "" %}
  {% set first = true %}
  {% for section in faqs.sections %}{% for item in section.items %}{% if first %}{% set first = false %}{% else %}{% set qjson = qjson ~ "," %}{% endif %}{% set qjson = qjson ~ '
      {
        "@type": "Question",
        "name": ' ~ (item.q | json | safe) ~ ',
        "acceptedAnswer": {
          "@type": "Answer",
          "text": ' ~ (item.a | json | safe) ~ '
        }
      }' %}{% endfor %}{% endfor %}
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ seo.canonical }}#webpage",
    "url": "{{ site.url }}/faq/",
    "mainEntity": [{{ qjson | safe }}
    ]
  }
</script>
