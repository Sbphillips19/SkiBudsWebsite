<footer class="foot" id="contact">
  <div class="shell">
    <div class="foot__grid">
      <div>
        <h2 class="foot__title">{{ site.name }}</h2>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot__title">Follow</h2>
        <ul>
          <li><a href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer">Instagram<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          <li><a href="{{ site.social.facebook }}" target="_blank" rel="noopener noreferrer">Facebook<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          <li><a href="{{ site.social.youtube }}" target="_blank" rel="noopener noreferrer">YouTube<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot__title">Legal</h2>
        <ul>
          <li><a href="/terms">Terms of Service</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/faq">FAQ</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot__title">Updates</h2>
        <ul>
          <li><a href="/weather/">Weather &amp; snow</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot__title">Partnerships</h2>
        <ul>
          <li><a href="/affiliates">Partners</a></li>
          <li><a href="{{ site.social.linkedin }}" target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        </ul>
      </div>
    </div>
    <div class="foot__base">
      <p>&copy; {{ site.year }} {{ site.company }}. All rights reserved.</p>
      <p>Built in {{ site.location }}</p>
    </div>
  </div>
</footer>
