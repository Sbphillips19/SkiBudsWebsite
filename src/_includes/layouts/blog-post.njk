---
layout: base.njk
article: true
articleType: BlogPosting
ogType: article
parentTitle: App updates
parentUrl: /blog/
pageScripts:
  - content-engaged.js
---

<article class="blog-post shell">
  {% include "partials/breadcrumbs.njk" %}
  <header class="blog-post__header">
    <p class="blog-post__meta">
      <span>By {{ site.name }}</span>
      <time datetime="{{ date | isoDate }}">{{ date | dateDisplay }}</time>
      {% if lastModified and (lastModified | isoDate) != (date | isoDate) %}
      <span>Updated <time datetime="{{ lastModified | isoDate }}">{{ lastModified | dateDisplay }}</time></span>
      {% endif %}
      {% if tags %}
        {% for tag in tags %}
          <span class="blog-post__tag">{{ tag }}</span>
        {% endfor %}
      {% endif %}
    </p>
    <h1>{{ title | escape }}</h1>
    {% if description %}
      <p class="blog-post__description">{{ description | escape }}</p>
    {% endif %}
  </header>

  <div class="blog-post__content">
    {{ content | safe }}
  </div>

  <footer class="blog-post__footer">
    <hr>
    <p><a href="{{ parentUrl }}">&larr; {{ parentTitle }}</a> &middot; <a href="/find-ski-buddies/">Find ski buddies</a> &middot; <a href="/weather/">Snow forecasts</a></p>
    <p>SkiBuds is coming soon to iOS and Android.</p>
    <a href="/#waitlist" class="btn" data-track-cta="article-join-waitlist">Get launch updates &rarr;</a>
  </footer>
</article>

<!-- Content engagement: fires once when the reader scrolls past 50% of the article -->
