---
layout: base.njk
pageScripts:
  - content-engaged.js
---

<article class="blog-post">
  <header class="blog-post__header">
    <p class="blog-post__meta">
      <time datetime="{{ page.date }}">{{ page.date | dateDisplay }}</time>
      {% if tags %}
        {% for tag in tags %}
          <span class="blog-post__tag">{{ tag }}</span>
        {% endfor %}
      {% endif %}
    </p>
    <h1>{{ title }}</h1>
    {% if description %}
      <p class="blog-post__description">{{ description }}</p>
    {% endif %}
  </header>

  <div class="blog-post__content">
    {{ content | safe }}
  </div>

  <footer class="blog-post__footer">
    <hr>
    <p><a href="/blog">← All updates</a> · <a href="/">Home</a></p>
  </footer>
</article>

<!-- Content engagement: fires once when the reader scrolls past 50% of the article -->
