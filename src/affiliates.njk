---
layout: base.njk
title: Partners
description: Shops, clubs, and trip organizers SkiBuds works with across North America.
eleventyExcludeFromCollections: true
pageScripts:
  - partner-filter.js
  - partner-outbound.js
---

<section class="band">
  <div class="shell">
    <p class="eyebrow">Partners</p>
    <h1>Good people we ride with</h1>
    <p class="lede">
      Shops, clubs, and trip organizers we work with across North America. Want to be
      listed? <a href="mailto:{{ site.email }}">Get in touch</a>.
    </p>

    <!-- Category filter -->
    <div class="partner-filters" style="margin-bottom: 2rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <button class="btn partner-filter-btn partner-filter-btn--active" data-filter="all" aria-pressed="true">All</button>
      <button class="btn btn--quiet partner-filter-btn" data-filter="shop" aria-pressed="false">Shops</button>
      <button class="btn btn--quiet partner-filter-btn" data-filter="club" aria-pressed="false">Clubs</button>
      <button class="btn btn--quiet partner-filter-btn" data-filter="trip-organizer" aria-pressed="false">Trip Organizers</button>
    </div>

    <div class="partners">
      {% for partner in site.partners %}
      <article class="partner" data-category="{{ partner.category }}">
        <a href="{{ partner.url }}" target="_blank" rel="noopener">
          {% image partner.logo, partner.name, "auto", "", "lazy" %}
        </a>
        <h3>{{ partner.name }}</h3>
        <p>{{ partner.description | safe }}</p>
        <span class="partner-category" style="display: inline-block; margin-top: 0.5rem; font-size: 0.75rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted);">{{ partner.category | capitalize }}</span>
      </article>
      {% endfor %}
    </div>
  </div>
</section>



<!-- Partner outbound tracking: delegated listener, once per link per pageload, no preventDefault -->
